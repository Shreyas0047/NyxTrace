# NyxTrace — Project-level environment overrides
# These are read by start-all.sh and can override backend/.env values.
# Copy to .env and adjust as needed. NEVER commit the real .env file.

# =================== SERVICE PORTS (start-all.sh) ===================
BACKEND_PORT=3000
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000
SANDBOX_AGENT_PORT=9090

# =================== STARTUP CONTROLS ===================
# Set to "true" to skip a service during start-all.sh
SKIP_BACKEND=false
SKIP_FRONTEND=false
SKIP_AI=false
SKIP_SANDBOX=false

# =================== BACKEND OVERRIDES ===================
# These override values in backend/.env when start-all.sh runs
# MONGODB_URI=mongodb://localhost:27017/forensics_platform
# JWT_SECRET=...
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# =================== SANDBOX AGENT ===================
SANDBOX_AGENT_SECRET=your-shared-sandbox-agent-secret
