# NyxTrace — Environment Configuration
# Copy this file to .env (same directory) and fill in your values.
#   cp .env.example .env
# NEVER commit the real .env file to version control.

# =================== SERVER ===================
PORT=3000
NODE_ENV=development
API_VERSION=v1
BASE_URL=http://localhost:3000

# =================== MONGODB ===================
# Local (no auth):    mongodb://localhost:27017/forensics_platform
# Atlas (production): mongodb+srv://<user>:<pass>@cluster.mongodb.net/forensics_platform
MONGODB_URI=mongodb://localhost:27017/forensics_platform
MONGODB_DATABASE=forensics_platform
MONGODB_OPTIONS=maxPoolSize=10&wtimeout=30000

# =================== JWT ===================
# Generate strong secrets:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-hex-string
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=change-me-to-another-random-64-hex-string
JWT_REFRESH_EXPIRY=30d

# =================== SECURITY ===================
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# =================== FILE UPLOAD ===================
UPLOAD_MAX_SIZE=104857600
UPLOAD_DEST=./uploads
ALLOWED_FILE_TYPES=.json,.zip,.pdf,.log,.txt,.png,.jpg,.jpeg
EVIDENCE_PATH=./uploads/evidence
REPORTS_PATH=./uploads/reports
SANDBOX_LOGS_PATH=./uploads/sandbox-logs

# =================== SMTP (OTP delivery) ===================
# For Gmail use an App Password (enable 2FA → App passwords):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=NyxTrace <your-email@gmail.com>

# =================== AI SERVICE ===================
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=false

# =================== LOGGING ===================
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30

# =================== SANDBOX AGENT ===================
SANDBOX_SYNC_ENABLED=true
SANDBOX_API_KEY=

# =================== BLOCKCHAIN ===================
# Local Hardhat node:   http://127.0.0.1:8545  chainId=31337
# Sepolia testnet:      https://sepolia.infura.io/v3/<project-id>  chainId=11155111
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_EXPLORER_URL=http://127.0.0.1:8545
BLOCKCHAIN_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Hardhat account #0 private key — ONLY for local dev, NEVER use in production
# Default: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_PRIVATE_KEY=<your-hardhat-account-private-key>
AUTO_VERIFY_ON_UPLOAD=true
STORE_HASHES_ON_CHAIN=true