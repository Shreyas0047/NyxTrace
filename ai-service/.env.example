# AI Service — Environment Variables
# Copy to .env and customize

# --- Service ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# --- CORS ---
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- API Key (optional auth for all endpoints except /health) ---
# AI_API_KEY=

# --- Rate Limiting ---
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=60
AI_RATE_LIMIT_WINDOW=60

# --- Cache ---
AI_CACHE_ENABLED=true
AI_CACHE_MAX_SIZE=128
AI_CACHE_TTL=300

# --- LLM Integration ---
# Enable LLM analysis (affects both legacy llm_integration.py and new llm_router.py)
AI_LLM_ENABLED=true

# Provider: ollama | openai
AI_LLM_PROVIDER=ollama

# Ollama settings
AI_LLM_OLLAMA_URL=http://localhost:11434
AI_LLM_OLLAMA_MODEL=llama3.2

# OpenAI settings (only needed when AI_LLM_PROVIDER=openai)
# AI_LLM_OPENAI_API_KEY=
AI_LLM_OPENAI_MODEL=gpt-4o-mini

# --- LLM Router (dual-gated: requires AI_LLM_ENABLED=true + AI_LLM_PRIMARY_PATH=true) ---
# When enabled, replaces 5 heuristic modules with one structured Llama call
AI_LLM_PRIMARY_PATH=true
AI_LLM_TEMPERATURE=0.1
AI_LLM_MAX_RESPONSE_TOKENS=2000
AI_LLM_MAX_EVENTS_IN_PROMPT=50
AI_LLM_FALLBACK_TO_HEURISTIC=true
AI_LLM_RETRY_ON_FAILURE=true
AI_LLM_OLLAMA_PING_TIMEOUT=5

# LLM timeout for generate requests (seconds)
AI_LLM_TIMEOUT=60

# --- Backend ---
BACKEND_API_URL=http://localhost:3000
